# ========================
# Stroyscrape — конфигурация
# Скопируй в .env и заполни
# ========================

# --- Сервер ---
PORT=3001

# --- База данных и файлы ---
DATA_DIR=./data

# --- Парсинг ---
# Глубина парсинга в днях (по умолчанию: 7)
DAYS_BACK=7

# Автоматический ежедневный парсинг при запуске сервера (true/false)
AUTO_SCRAPE=true

# Отключённые источники через запятую (по ID):
#   stroygaz, rbc_realty, rcmm, irn, stroi_mos, mperspektiva,
#   minstroyrf, ancb, mos_stroinadzor, cnews, servernews, comnews,
#   3dnews, ixbt, spbit, itworld, dtf
# SOURCES_DISABLED=rcmm,ancb

# --- AI API (OpenAI-совместимый) ---
# Ключ API (обязательно)
DEEPSEEK_API_KEY=sk-your-key-here

# Базовый URL API (/chat/completions добавится автоматически)
# DeepSeek:  https://api.deepseek.com
# OpenRouter: https://openrouter.ai/api/v1
# Локально:  http://localhost:8000/v1
DEEPSEEK_API_BASE=https://api.deepseek.com

# Модель для классификации статей (лёгкая задача — быстро и дёшево)
CLASSIFIER_MODEL=deepseek-chat

# Модель для генерации аналитических отчётов
ANALYSIS_MODEL=deepseek-chat

# --- Логирование ---
# Уровни: trace, debug, info, warn, error
LOG_LEVEL=info
